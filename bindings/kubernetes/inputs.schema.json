{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nightscout/staging-inputs.schema.json",
  "title": "Synthetic staging Kubernetes binding inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "sourceCommit",
    "imageDeployCommit",
    "bindingIdentity",
    "runId",
    "profile",
    "images",
    "storage"
  ],
  "properties": {
    "namespace": {
      "type": "string"
    },
    "prefix": {
      "const": "nsdemo"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "imageDeployCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "bindingIdentity": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "standard",
        "existing-capacity"
      ]
    },
    "tenantCount": {
      "type": "integer",
      "minimum": 1
    },
    "postgresMaxConnections": {
      "type": ["integer", "null"],
      "minimum": 44,
      "maximum": 10000,
      "default": null
    },
    "pools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "realtime": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "evaluator": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "operation": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "read": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "evaluatorMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseMiB": { "type": "number", "exclusiveMinimum": 0 },
        "perResidentMiB": { "type": "number", "minimum": 0 },
        "heapHeadroom": { "type": "number", "minimum": 1, "maximum": 4 }
      }
    },
    "residentHeadroomZ": { "type": "number", "minimum": 0, "maximum": 10 },
    "provisionDeadlineSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "postgres"
      ],
      "properties": {
        "app": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "postgres": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "vault": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "nginx": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "postgresSettings": {
      "type": "object",
      "description": "PostgreSQL server settings passed as -c name=value; empty keeps the image defaults.",
      "propertyNames": {
        "pattern": "^[a-z][a-z_]{1,62}$",
        "not": { "enum": ["max_connections", "reserved_connections", "shared_preload_libraries"] }
      },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" }
    },
    "postgresSizing": {
      "description": "PostgreSQL tier from lib/ns/postgres-sizing.json (settings, requests, claim); null keeps the image defaults.",
      "enum": [null, "1k", "5k", "10k"]
    },
    "postgresNode": {
      "description": "PostgreSQL alone on its own node: its nodeSelector and a NoSchedule toleration for the operator-made taint key=value:NoSchedule; no other workload may tolerate the key.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["nodeSelector", "taint"],
      "properties": {
        "nodeSelector": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
        "taint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": { "key": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requests": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              },
              "memory": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              },
              "ephemeral-storage": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              },
              "memory": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              },
              "ephemeral-storage": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
              }
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "placementByWorkload": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodeSelector": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tolerations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "affinity": {
            "type": "object"
          },
          "topologySpreadConstraints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dynamic",
            "disposable",
            "existing-claim"
          ]
        },
        "postgres": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
        },
        "vault": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
        },
        "provisionState": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
        },
        "primerResults": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|Mi|Gi)?$"
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": {
              "type": "string",
              "minLength": 1
            },
            "vault": {
              "type": "string",
              "minLength": 1
            },
            "provisionState": {
              "type": "string",
              "minLength": 1
            },
            "primerResults": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "vaultAgent": {
      "type": "object"
    },
    "edge": {
      "type": "object"
    },
    "resourceAccounting": {
      "enum": [
        "limits-v1",
        "requests-v1"
      ]
    },
    "terminationGraceSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "apiReplicas": {"type": "integer", "minimum": 1, "maximum": 16},
    "inputTransport": {"enum": ["writer-driven"]},
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "realtime": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Realtime K: StatefulSet replicas and NS_SLICE_COUNT."
        },
        "evaluator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Evaluator K: StatefulSet replicas and NS_EVALUATOR_SLICES; each Pod takes its ordinal from its hostname. K>1 addresses evaluator-<i>.evaluator; scripts/secrets.sh seed must then run with the same NS_EVALUATOR_WORKERS. The maximum equals evaluator-workers.js MAX_WORKERS (check/evaluator-slices.test.js)."
        }
      }
    },
    "roleEnv": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extra environment rows per application role, appended after the binding's own rows (diagnostics and profiling switches).",
      "properties": {
        "api": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "evaluator": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "realtime": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "tenant-admin": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "socketEdge": {
      "type": "object",
      "additionalProperties": false,
      "description": "socket-edge, the realtime routing proxy rendered when slices.realtime > 1 (lib/ns/components.libsonnet). It holds no per-connection state, so its replicas need no client affinity.",
      "properties": {
        "replicas": { "type": ["integer", "null"], "minimum": 1, "maximum": 16, "description": "null renders realtime K replicas (one per realtime slice)." }
      }
    },
    "vcpool": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in vcpool role (lib/ns/vcpool.libsonnet): the tenant-side Nightscout connector, one StatefulSet Pod, and the suspended connector-entry operator Job. Off by default.",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowHosts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9.-]{1,253}$" } },
        "allowInsecureHttp": { "type": "boolean" },
        "egressProxy": { "type": ["string", "null"] },
        "metrics": { "type": "boolean" }
      }
    },
    "labMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in lab metrics (lib/ns/lab-metrics.libsonnet): one Prometheus per run namespace, a postgres_exporter sidecar and NS_METRICS=true on the application roles. Off by default.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scrapeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+[smhd]$"
        },
        "storage": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prometheus": {
              "type": "string",
              "pattern": "@sha256:[0-9a-f]{64}$"
            },
            "postgresExporter": {
              "type": "string",
              "pattern": "@sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
