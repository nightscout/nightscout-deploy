+
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/notifier"
+)
+
+type startupRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f startupRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func startupConfig(urls ...string) WebhookStartupTransportConfig {
+	return WebhookStartupTransportConfig{Receivers: urls, TimeoutMS: 1000, RetryIntervalMS: 5}
+}
+func startupResponse(status int) *http.Response {
+	return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}
+}
+func dialRefused() error {
+	return &net.OpError{Op: "dial", Net: "tcp", Err: &os.SyscallError{Syscall: "connect", Err: syscall.ECONNREFUSED}}
+}
+
+func TestStartupTransportValidation(t *testing.T) {
+	a, b := "http://worker-a:19913/pgstream", "http://worker-b:19913/pgstream"
+	good := startupConfig(a, b)
+	require.NoError(t, good.validate(nil))
+	batch := &notifier.TransactionBatchConfig{MaxRows: 10, MaxBytes: 1000, SliceReceivers: []string{a, b}}
+	require.NoError(t, good.validate(batch))
+	for name, mutate := range map[string]func(*WebhookStartupTransportConfig){
+		"nil": func(c *WebhookStartupTransportConfig) { c.Receivers = nil }, "empty": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{} },
+		"duplicate": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{a, a} }, "userinfo": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{"http://secret@worker:19913/pgstream"} },
+		"path": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{"http://worker:19913/pgstream/ready"} }, "query": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{a + "?key=secret"} },
+		"https": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{"https://worker:19913/pgstream"} }, "port": func(c *WebhookStartupTransportConfig) { c.Receivers = []string{"http://worker/pgstream"} },
+		"zero": func(c *WebhookStartupTransportConfig) { c.TimeoutMS = 0 }, "overflow": func(c *WebhookStartupTransportConfig) { c.TimeoutMS = 1<<63 - 1 }, "negative": func(c *WebhookStartupTransportConfig) { c.RetryIntervalMS = -1 }, "interval": func(c *WebhookStartupTransportConfig) { c.RetryIntervalMS = c.TimeoutMS + 1 },
+	} {
+		t.Run(name, func(t *testing.T) { c := startupConfig(a, b); mutate(&c); require.Error(t, c.validate(nil)) })
+	}
+	for _, roster := range [][]string{{b, a}, {a}, {a, b, "http://worker-c:19913/pgstream"}} {
+		c := startupConfig(roster...)
+		require.Error(t, c.validate(batch))
+	}
+	// Reference milliseconds are defaults, not a ceiling.
+	large := startupConfig(a)
+	large.TimeoutMS = 7200000
+	large.RetryIntervalMS = 100
+	require.NoError(t, large.validate(nil))
+}
+
+func TestStartupTransportAllReceiversAndOnlyDialRefusalRetries(t *testing.T) {
+	config := startupConfig("http://worker-a:19913/pgstream", "http://worker-b:19913/pgstream")
+	var requests []string
+	transport := startupRoundTrip(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, http.MethodGet, r.Method)
+		require.Equal(t, "/pgstream/ready", r.URL.Path)
+		require.Empty(t, r.Header.Get("Authorization"))
+		require.Nil(t, r.Body)
+		requests = append(requests, r.URL.Host)
+		if len(requests) == 1 {
+			return nil, dialRefused()
+		}
+		return startupResponse(204), nil
+	})
+	require.NoError(t, awaitStartupTransport(context.Background(), config, transport))
+	require.Equal(t, []string{"worker-a:19913", "worker-a:19913", "worker-b:19913"}, requests, "every configured receiver must pass in ordinal order")
+}
+
+func TestStartupTransportHardHTTPAndNetworkFailures(t *testing.T) {
+	for _, status := range []int{200, 301, 302, 307, 401, 403, 404, 429, 500, 503} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			calls := 0
+			err := awaitStartupTransport(context.Background(), startupConfig("http://worker:19913/pgstream"), startupRoundTrip(func(*http.Request) (*http.Response, error) { calls++; return startupResponse(status), nil }))
+			require.ErrorContains(t, err, "HTTP status")
+			require.Equal(t, 1, calls)
+		})
+	}
+	for name, failure := range map[string]error{"dns": &net.OpError{Op: "dial", Err: &net.DNSError{Err: "no such host", IsNotFound: true}}, "timeout": &net.OpError{Op: "dial", Err: context.DeadlineExceeded}, "reset": &net.OpError{Op: "read", Err: syscall.ECONNRESET}, "readRefused": &net.OpError{Op: "read", Err: syscall.ECONNREFUSED}, "EOF": io.EOF, "text": errors.New("dial connection refused"), "permission": &net.OpError{Op: "dial", Err: syscall.EACCES}} {
+		t.Run(name, func(t *testing.T) {
+			calls := 0
+			err := awaitStartupTransport(context.Background(), startupConfig("http://worker:19913/pgstream"), startupRoundTrip(func(*http.Request) (*http.Response, error) { calls++; return nil, failure }))
+			require.ErrorContains(t, err, "network failure refused")
+			require.Equal(t, 1, calls)
+			require.NotContains(t, err.Error(), "http://")
+		})
+	}
+}
+
+func TestStartupTransportFiniteNeverReadyAndCancellation(t *testing.T) {
+	for _, cancelNow := range []bool{false, true} {
+		t.Run(map[bool]string{false: "deadline", true: "cancel"}[cancelNow], func(t *testing.T) {
+			config := startupConfig("http://worker:19913/pgstream")
+			config.TimeoutMS = 75
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls := 0
+			start := time.Now()
+			err := awaitStartupTransport(ctx, config, startupRoundTrip(func(*http.Request) (*http.Response, error) {
+				calls++
+				if cancelNow {
+					cancel()
+				}
+				return nil, dialRefused()
+			}))
+			require.Error(t, err)
+			require.Less(t, time.Since(start), time.Second)
+			require.Positive(t, calls)
+			if cancelNow {
+				require.ErrorIs(t, err, context.Canceled)
+				require.Equal(t, 1, calls)
+			} else {
+				require.ErrorIs(t, err, context.DeadlineExceeded)
+				require.Greater(t, calls, 1)
+			}
+		})
+	}
+}
+
+func TestStartupTransportActualHTTPNoRedirectProxyOrHiddenReentry(t *testing.T) {
+	var targetCalls atomic.Int64
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { targetCalls.Add(1); w.WriteHeader(204) }))
+	defer target.Close()
+	redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Redirect(w, r, target.URL, 302) }))
+	defer redirect.Close()
+	t.Setenv("HTTP_PROXY", target.URL)
+	t.Setenv("http_proxy", target.URL)
+	t.Setenv("NO_PROXY", "")
+	makeConfig := func(address string) *Config {
+		return &Config{Listener: ListenerConfig{Postgres: &PostgresListenerConfig{}}, Processor: ProcessorConfig{Webhook: &WebhookProcessorConfig{StartupTransport: func() *WebhookStartupTransportConfig { v := startupConfig(address + "/pgstream"); return &v }()}}}
+	}
+	require.ErrorContains(t, makeConfig(redirect.URL).AwaitStartupTransport(context.Background()), "HTTP status 302")
+	require.EqualValues(t, 0, targetCalls.Load(), "redirect/proxy target must receive no request")
+	c := makeConfig(target.URL)
+	require.NoError(t, c.AwaitStartupTransport(context.Background()))
+	require.EqualValues(t, 1, targetCalls.Load())
+	time.Sleep(25 * time.Millisecond)
+	require.EqualValues(t, 1, targetCalls.Load(), "success leaves no background probe or renewable grace")
+	c.Processor.Webhook.StartupTransport = nil
+	require.NoError(t, c.AwaitStartupTransport(context.Background()))
+	require.EqualValues(t, 1, targetCalls.Load())
+}
+
+func TestStartupTransportActualRefusedSocketThenOwnedListener(t *testing.T) {
+	reservation, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	address := reservation.Addr().String()
+	require.NoError(t, reservation.Close())
+	config := startupConfig("http://" + address + "/pgstream")
+	done := make(chan error, 1)
+	go func() {
+		c := &Config{Listener: ListenerConfig{Postgres: &PostgresListenerConfig{}}, Processor: ProcessorConfig{Webhook: &WebhookProcessorConfig{StartupTransport: &config}}}
+		done <- c.AwaitStartupTransport(context.Background())
+	}()
+	select {
+	case err := <-done:
+		t.Fatalf("returned before listener bind: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	listener, err := net.Listen("tcp", address)
+	require.NoError(t, err)
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/pgstream/ready" {
+			t.Errorf("wrong endpoint %s", r.URL.Path)
+		}
+		w.WriteHeader(204)
+	})}
+	defer server.Close()
+	go server.Serve(listener)
+	select {
+	case err := <-done:
+		require.NoError(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("did not observe actual listener")
+	}
+}
+
+func TestStartupTransportCancellationCannotEarn204Success(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	err := awaitStartupTransport(ctx, startupConfig("http://worker:19913/pgstream"), startupRoundTrip(func(*http.Request) (*http.Response, error) { cancel(); return startupResponse(204), nil }))
+	require.ErrorIs(t, err, context.Canceled)
+}
