+func TestTransactionFramingKeepaliveRepeatsOnlyAcknowledgedCommit(t *testing.T) {
+	identity := &wal.SourceIdentity{SystemID: "100", Timeline: 2, Database: "synthetic", Slot: "framing"}
+	var acknowledgements []uint64
+	h := &Handler{logger: loglib.NewNoopLogger(), logFields: loglib.Fields{}, lsnParser: NewLSNParser(), transactionFraming: true, sourceIdentity: identity, pgReplicationConn: &pgmocks.ReplicationConn{
+		ReceiveMessageFn: func(context.Context) (*pglib.ReplicationMessage, error) {
+			return &pglib.ReplicationMessage{LSN: 99999, ReplyRequested: true}, nil
+		},
+		SendStandbyStatusUpdateFn: func(_ context.Context, lsn uint64) error {
+			acknowledgements = append(acknowledgements, lsn)
+			return nil
+		},
+	}}
+	require.NoError(t, h.SyncLSN(t.Context(), replication.LSN(100)))
+	message, err := h.ReceiveMessage(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, []uint64{100, 100}, acknowledgements, "server WAL end is not complete transaction coverage")
+	require.Same(t, identity, message.SourceIdentity)
+}
+func TestTransactionFramingFailedAckDoesNotBecomeCoverage(t *testing.T) {
+	failure := errors.New("synthetic ACK failure")
