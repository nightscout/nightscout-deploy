diff --git a/pkg/stream/startup_transport.go b/pkg/stream/startup_transport.go
new file mode 100644
index 0000000..3accb1e
--- /dev/null
+++ b/pkg/stream/startup_transport.go
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package stream
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"slices"
+	"syscall"
+	"time"
+
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/notifier"
+)
+
+// WebhookStartupTransportConfig is an optional native run-command prerequisite.
+// It does not change notifier delivery retries or establish clinical readiness.
+type WebhookStartupTransportConfig struct {
+	Receivers       []string `mapstructure:"receivers" yaml:"receivers"`
+	TimeoutMS       int64    `mapstructure:"timeout_ms" yaml:"timeout_ms"`
+	RetryIntervalMS int64    `mapstructure:"retry_interval_ms" yaml:"retry_interval_ms"`
+}
+
+func (c *WebhookStartupTransportConfig) validate(batch *notifier.TransactionBatchConfig) error {
+	const maxMilliseconds = int64((1<<63 - 1) / time.Millisecond)
+	if c.TimeoutMS <= 0 || c.TimeoutMS > maxMilliseconds || c.RetryIntervalMS <= 0 || c.RetryIntervalMS > c.TimeoutMS {
+		return errors.New("startup transport requires positive representable timeout/retry milliseconds")
+	}
+	// Reuse the existing exact ordered-instance URL and duplicate checks. The
+	// temporary positive bounds validate URLs without changing delivery framing.
+	if c.Receivers == nil || (&notifier.TransactionBatchConfig{MaxRows: 1, MaxBytes: 1, SliceReceivers: c.Receivers}).Validate() != nil {
+		return errors.New("startup transport requires explicit canonical receiver instances")
+	}
+	if batch != nil && batch.SliceReceivers != nil && !slices.Equal(c.Receivers, batch.SliceReceivers) {
+		return errors.New("startup transport must match the exact ordered slice receivers")
+	}
+	return nil
+}
+
+// AwaitStartupTransport is called once by the native run command, before health
+// source pools, initialization or replication. Library Run callers do not opt in
+// implicitly. Success leaves no retry state behind; later delivery remains strict.
+func (c *Config) AwaitStartupTransport(ctx context.Context) error {
+	if c.Processor.Webhook == nil || c.Processor.Webhook.StartupTransport == nil {
+		return nil
+	}
+	if err := c.IsValid(); err != nil {
+		return fmt.Errorf("invalid startup transport configuration: %w", err)
+	}
+	selected := *c.Processor.Webhook.StartupTransport
+	selected.Receivers = slices.Clone(selected.Receivers)
+	transport := &http.Transport{Proxy: nil, DialContext: (&net.Dialer{}).DialContext, DisableKeepAlives: true}
+	defer transport.CloseIdleConnections()
+	return awaitStartupTransport(ctx, selected, transport)
+}
+
+func awaitStartupTransport(ctx context.Context, config WebhookStartupTransportConfig, transport http.RoundTripper) error {
+	ctx, cancel := context.WithTimeout(ctx, time.Duration(config.TimeoutMS)*time.Millisecond)
+	defer cancel()
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	for ordinal, receiver := range config.Receivers {
+		endpoint, _ := url.Parse(receiver) // validated before any I/O
+		endpoint.Path = "/pgstream/ready"
+		for {
+			if ctx.Err() != nil {
+				return fmt.Errorf("startup transport receiver %d deadline/cancellation: %w", ordinal, ctx.Err())
+			}
+			request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+			if err != nil {
+				return errors.New("startup transport request refused")
+			}
+			response, err := client.Do(request)
+			if err == nil {
+				response.Body.Close()
+				if ctx.Err() != nil {
+					return fmt.Errorf("startup transport receiver %d deadline/cancellation: %w", ordinal, ctx.Err())
+				}
+				if response.StatusCode != http.StatusNoContent {
+					return fmt.Errorf("startup transport receiver %d HTTP status %d refused", ordinal, response.StatusCode)
+				}
+				break
+			}
+			if ctx.Err() != nil {
+				return fmt.Errorf("startup transport receiver %d deadline/cancellation: %w", ordinal, ctx.Err())
+			}
+			if !startupDialRefused(err) {
+				// Do not echo URLs, credentials, response bodies or raw network errors.
+				return fmt.Errorf("startup transport receiver %d network failure refused", ordinal)
+			}
+			timer := time.NewTimer(time.Duration(config.RetryIntervalMS) * time.Millisecond)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return fmt.Errorf("startup transport receiver %d deadline/cancellation: %w", ordinal, ctx.Err())
+			case <-timer.C:
+			}
+		}
+	}
+	if ctx.Err() != nil {
+		return fmt.Errorf("startup transport deadline/cancellation: %w", ctx.Err())
+	}
+	return nil
+}
+
+func startupDialRefused(err error) bool {
+	var operation *net.OpError
+	return errors.As(err, &operation) && operation.Op == "dial" && errors.Is(operation.Err, syscall.ECONNREFUSED)
+}
