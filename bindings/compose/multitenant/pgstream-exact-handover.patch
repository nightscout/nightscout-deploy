+	"testing"
+)
+
+func TestBoundedTransactionBatchRequiresNativeFramedPipeline(t *testing.T) {
+	c := &Config{Listener: ListenerConfig{Postgres: &PostgresListenerConfig{}}, Processor: ProcessorConfig{Webhook: &WebhookProcessorConfig{}}}
+	c.Listener.Postgres.Replication.PluginArguments.IncludeTransactions = true
+	c.Processor.Webhook.Notifier.StrictMode = true
+	c.Processor.Webhook.Notifier.TransactionBatch = &notifier.TransactionBatchConfig{MaxRows: 128, MaxBytes: 1024 * 1024}
+	require.NoError(t, c.IsValid())
+	c.Listener.Postgres.Replication.PluginArguments.IncludeTransactions = false
+	require.ErrorContains(t, c.IsValid(), "transaction batching requires")
+	c.Listener.Postgres.Replication.PluginArguments.IncludeTransactions = true
+	c.Processor.Webhook.Notifier.TransactionBatch.MaxBytes = 0
+	require.ErrorContains(t, c.IsValid(), "transaction batching requires")
+}
+
+func TestStaticSliceRosterRequiresNativeFramedPipeline(t *testing.T) {
+	c := &Config{Listener: ListenerConfig{Postgres: &PostgresListenerConfig{}}, Processor: ProcessorConfig{Webhook: &WebhookProcessorConfig{}}}
+	c.Listener.Postgres.Replication.PluginArguments.IncludeTransactions = true
+	c.Processor.Webhook.Notifier.StrictMode = true
+	b := &notifier.TransactionBatchConfig{MaxRows: 128, MaxBytes: 1024 * 1024, SliceReceivers: []string{"http://evaluator:19913/pgstream", "http://evaluator-2:19913/pgstream"}}
+	c.Processor.Webhook.Notifier.TransactionBatch = b
+	require.NoError(t, c.IsValid())
+	b.SliceReceivers = []string{}
+	require.Error(t, c.IsValid(), "explicit empty roster refuses before starting the source")
+	b.SliceReceivers = []string{"http://evaluator:19913/pgstream", "http://evaluator:19913/pgstream"}
+	require.Error(t, c.IsValid(), "duplicate receiver refuses")
+	b.SliceReceivers = []string{"http://evaluator:19913/pgstream"}
+	require.NoError(t, c.IsValid())
+}
