@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+)
+
+func batchFixture() (*Notifier, []*subscription.Subscription, func(string, uint64) *wal.Event) {
+	n := New(&Config{StrictMode: true, TransactionBatch: &TransactionBatchConfig{MaxRows: 2, MaxBytes: 4096}}, nil)
+	subs := []*subscription.Subscription{{URL: "http://receiver/"}}
+	source := &wal.SourceIdentity{SystemID: "native-source", Timeline: 1, Database: "clinical", Slot: "deployment"}
+	event := func(action string, index uint64) *wal.Event {
+		d := &wal.Data{Action: action, XID: 123, LSN: "0/100", TransactionIndex: &index}
+		e := &wal.Event{Data: d}
+		if action == "B" || action == "C" {
+			d.SourceIdentity = source
+			d.NextLSN = "0/200"
+		}
+		if action == "C" {
+			count := index - 1
+			d.TransactionCount = &count
+			e.CommitPosition = "0/200"
+		}
+		return e
+	}
+	return n, subs, event
+}
+func TestTransactionBatchOnlyCompleteEnvelopeCanBeSent(t *testing.T) {
+	n, subs, event := batchFixture()
+	for _, e := range []*wal.Event{event("B", 0), event("I", 1), event("U", 2)} {
+		msg, err := n.batchTransaction(e, subs)
+		require.NoError(t, err)
+		require.Nil(t, msg, "partial input cannot enter HTTP queue")
+	}
+	msg, err := n.batchTransaction(event("C", 3), subs)
+	require.NoError(t, err)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+	var payload struct{ Transaction []*wal.Data }
+	require.NoError(t, json.Unmarshal(msg.payload, &payload))
+	require.Len(t, payload.Transaction, 4)
+	require.Equal(t, []string{"B", "I", "U", "C"}, []string{payload.Transaction[0].Action, payload.Transaction[1].Action, payload.Transaction[2].Action, payload.Transaction[3].Action})
+	require.Equal(t, []string{"http://receiver/"}, msg.urls)
+	require.Nil(t, n.batch)
+}
+func TestTransactionBatchRefusesUnrecoverablePartialAcceptance(t *testing.T) {
+	for _, scenario := range []string{"rows", "bytes", "count", "index", "source", "destinations", "partial-checkpoint"} {
+		t.Run(scenario, func(t *testing.T) {
+			n, subs, event := batchFixture()
+			_, err := n.batchTransaction(event("B", 0), subs)
+			require.NoError(t, err)
+			row := event("I", 1)
+			switch scenario {
+			case "rows":
+				n.transactionBatch.MaxRows = 0
+			case "bytes":
+				n.transactionBatch.MaxBytes = 1
+			case "index":
+				*row.Data.TransactionIndex = 2
+			case "destinations":
+				subs = []*subscription.Subscription{{URL: "http://other/"}}
+			case "partial-checkpoint":
+				row.CommitPosition = "0/200"
+			}
+			msg, err := n.batchTransaction(row, subs)
+			if scenario == "count" || scenario == "source" {
+				require.NoError(t, err)
+				require.Nil(t, msg)
+				c := event("C", 2)
+				if scenario == "count" {
+					*c.Data.TransactionCount = 0
+				} else {
+					changed := *c.Data.SourceIdentity
+					changed.Timeline = 2
+					c.Data.SourceIdentity = &changed
+				}
+				msg, err = n.batchTransaction(c, subs)
+			}
+			require.Error(t, err)
+			require.Nil(t, msg)
+			require.Nil(t, n.batch, "failed partial input must remain solely source-owned")
+		})
+	}
+}
+func TestTransactionBatchEmptyCohortCannotCreateReceiverFeedback(t *testing.T) {
+	n, subs, event := batchFixture()
+	_, err := n.batchTransaction(event("B", 0), subs)
+	require.NoError(t, err)
+	msg, err := n.batchTransaction(event("C", 1), subs)
+	require.NoError(t, err)
+	require.Empty(t, msg.urls)
+	require.Empty(t, msg.payload)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+}
+func TestTransactionBatchReconnectReplaysWholeCohort(t *testing.T) {
+	n, subs, event := batchFixture()
+	for _, e := range []*wal.Event{event("B", 0), event("I", 1), event("B", 0), event("I", 1)} {
+		m, err := n.batchTransaction(e, subs)
+		require.NoError(t, err)
+		require.Nil(t, m)
+	}
+	msg, err := n.batchTransaction(event("C", 2), subs)
+	require.NoError(t, err)
+	var payload struct{ Transaction []*wal.Data }
+	require.NoError(t, json.Unmarshal(msg.payload, &payload))
+	require.Len(t, payload.Transaction, 3)
+}
