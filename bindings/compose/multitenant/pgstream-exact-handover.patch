@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: Apache-2.0
+package stream
+
+import (
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal/processor/filter"
+	"github.com/xataio/pgstream/pkg/wal/processor/injector"
+	"github.com/xataio/pgstream/pkg/wal/processor/transformer"
+	"testing"
+)
+
+func TestTransactionFramingRejectsLossyPipeline(t *testing.T) {
+	makeConfig := func() *Config {
+		c := &Config{Listener: ListenerConfig{Postgres: &PostgresListenerConfig{}}, Processor: ProcessorConfig{Webhook: &WebhookProcessorConfig{}}}
+		c.Listener.Postgres.Replication.PluginArguments.IncludeTransactions = true
+		c.Processor.Webhook.Notifier.StrictMode = true
+		return c
+	}
+	require.NoError(t, makeConfig().IsValid())
+	for _, change := range []func(*Config){func(c *Config) { c.Processor.Webhook.Notifier.StrictMode = false }, func(c *Config) { c.Processor.Filter = &filter.Config{} }, func(c *Config) { c.Processor.Injector = &injector.Config{} }, func(c *Config) { c.Processor.Transformer = &transformer.Config{} }, func(c *Config) { c.Processor.Sanitize = &SanitizeConfig{} }} {
+		c := makeConfig()
+		change(c)
+		require.ErrorContains(t, c.IsValid(), "transaction framing requires")
+	}
+}
diff --git a/pkg/wal/listener/postgres/transaction_framing_test.go b/pkg/wal/listener/postgres/transaction_framing_test.go
new file mode 100644
index 0000000..c0d87f2
--- /dev/null
+++ b/pkg/wal/listener/postgres/transaction_framing_test.go
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+package postgres
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/replication"
+	pgreplication "github.com/xataio/pgstream/pkg/wal/replication/postgres"
+	"testing"
+)
+
+func TestTransactionFramingOnlyCompleteCommitAdvances(t *testing.T) {
+	var events []*wal.Event
+	h := newMockReplicationHandler()
+	h.GetLSNParserFn = func() replication.LSNParser { return pgreplication.NewLSNParser() }
+	l := New(h, func(_ context.Context, e *wal.Event) error { events = append(events, e); return nil }, WithTransactionFraming())
+	send := func(data string) {
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{LSN: 999, Data: []byte(data)}))
+	}
+	send(`{"action":"B","xid":7,"nextlsn":"0/100"}`)
+	send(`{"action":"I","xid":7,"lsn":"0/50","schema":"public","table":"items"}`)
+	require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{LSN: 99999, ReplyRequested: true}))
+	send(`{"action":"I","xid":7,"lsn":"0/50","schema":"public","table":"items"}`)
+	send(`{"action":"U","xid":7,"lsn":"0/60","schema":"pgstream","table":"internal"}`)
+	send(`{"action":"C","xid":7,"lsn":"0/90","nextlsn":"0/100"}`)
+	require.Len(t, events, 4, "internal rows and keepalive must not alter exposed transaction coverage")
+	for i, e := range events {
+		require.Equal(t, uint64(i), *e.Data.TransactionIndex)
+		if i < 3 {
+			require.Empty(t, e.CommitPosition, "no partial-cohort checkpoint")
+		}
+	}
+	require.Equal(t, uint64(2), *events[3].Data.TransactionCount)
+	require.Equal(t, wal.CommitPosition("0/100"), events[3].CommitPosition)
+}
+
+func TestTransactionFramingReconnectReplaysFromBegin(t *testing.T) {
+	var indices []uint64
+	l := New(newMockReplicationHandler(), func(_ context.Context, e *wal.Event) error {
+		indices = append(indices, *e.Data.TransactionIndex)
+		return nil
+	}, WithTransactionFraming())
+	for _, data := range []string{`{"action":"B","xid":7}`, `{"action":"I","xid":7}`, `{"action":"B","xid":7}`, `{"action":"I","xid":7}`, `{"action":"C","xid":7,"nextlsn":"0/100"}`} {
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+	require.Equal(t, []uint64{0, 1, 0, 1, 2}, indices)
+}
+
+func TestTransactionFramingRefusesUnboundedBoundary(t *testing.T) {
+	for _, data := range []string{`{"action":"I","xid":7}`, `{"action":"C","xid":7,"nextlsn":"0/100"}`, `{"action":"B"}`} {
+		l := New(newMockReplicationHandler(), func(context.Context, *wal.Event) error { t.Fatal("invalid framing reached consumer"); return nil }, WithTransactionFraming())
+		require.Error(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+	for _, data := range []string{`{"action":"I","xid":8}`, `{"action":"C","xid":7}`, `{"action":"C","xid":8,"nextlsn":"0/100"}`} {
+		l := New(newMockReplicationHandler(), func(context.Context, *wal.Event) error { return nil }, WithTransactionFraming())
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(`{"action":"B","xid":7}`)}))
+		require.Error(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+}
diff --git a/pkg/wal/listener/postgres/wal_pg_listener.go b/pkg/wal/listener/postgres/wal_pg_listener.go
index 461afee..655c7c7 100644
--- a/pkg/wal/listener/postgres/wal_pg_listener.go
+++ b/pkg/wal/listener/postgres/wal_pg_listener.go
@@ -22,6 +22,10 @@ type Listener struct {
 	lsnParser          replication.LSNParser
 	snapshotGenerator  snapshotGenerator
 	phaseTracker       *phase.Tracker
+	transactionFraming bool
+	transactionOpen    bool
+	transactionXID     int64
+	transactionIndex   uint64
 
 	// Function called for processing WAL events.
 	processEvent listenerProcessWalEvent
@@ -87,6 +91,12 @@ func WithPhaseTracker(t *phase.Tracker) Option {
 	}
 }
 
+// WithTransactionFraming preserves wal2json committed transaction boundaries.
+// No row or keepalive advances the replication checkpoint in this mode.
+func WithTransactionFraming() Option {
+	return func(l *Listener) { l.transactionFraming = true }
+}
+
 // Listen starts the subscription process to listen for updates from PG.
 func (l *Listener) Listen(ctx context.Context) error {
 	if l.snapshotGenerator != nil {
@@ -194,6 +204,46 @@ func (l *Listener) processWALEvent(ctx context.Context, msg *replication.Message
 		event.Data = nil
 	}
 
+	if l.transactionFraming {
+		if event.Data == nil {
+			return nil
+		}
+		event.CommitPosition = ""
+		data := event.Data
+		if data.Action == "B" || data.Action == "C" {
+			data.SourceIdentity = msg.SourceIdentity
+		}
+		switch data.Action {
+		case "B":
+			// A reconnect starts again at the last complete C. Replayed B resets
+			// only this constant-size framing state; consumers own durable staging.
+			if data.XID == 0 {
+				return errors.New("transaction begin missing xid")
+			}
+			l.transactionOpen = true
+			l.transactionXID = data.XID
+			l.transactionIndex = 0
+		case "C":
+			if !l.transactionOpen || data.XID != l.transactionXID || data.NextLSN == "" {
+				return errors.New("transaction commit missing matching begin or nextlsn")
+			}
+			if _, err := l.lsnParser.FromString(data.NextLSN); err != nil {
+				return fmt.Errorf("transaction nextlsn: %w", err)
+			}
+			count := l.transactionIndex
+			data.TransactionCount = &count
+			l.transactionIndex++
+			event.CommitPosition = wal.CommitPosition(data.NextLSN)
+			l.transactionOpen = false
+		default:
+			if !l.transactionOpen || data.XID != l.transactionXID {
+				return errors.New("transaction row missing matching begin")
+			}
+			l.transactionIndex++
+		}
+		index := l.transactionIndex
+		data.TransactionIndex = &index
+	}
 	return l.processEvent(ctx, event)
 }
 
