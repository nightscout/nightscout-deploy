diff --git a/pkg/wal/processor/webhook/notifier/transaction_batch.go b/pkg/wal/processor/webhook/notifier/transaction_batch.go
new file mode 100644
index 0000000..d236cce
--- /dev/null
+++ b/pkg/wal/processor/webhook/notifier/transaction_batch.go
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"slices"
+
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+)
+
+// The listener is serial in framed mode. This additional lock keeps this
+// opt-in processor's advertised concurrent-call contract explicit. No partial
+// envelope enters the sender queue, so neither partial HTTP success nor source
+// checkpoint advancement is possible. At most one bounded envelope is retained.
+type transactionBuffer struct {
+	payload bytes.Buffer
+	xid     int64
+	rows    uint64
+	source  wal.SourceIdentity
+	nextLSN string
+	urls    []string
+}
+
+func destinations(subscriptions []*subscription.Subscription) []string {
+	urls := make([]string, 0, len(subscriptions))
+	for _, s := range subscriptions {
+		urls = append(urls, s.URL)
+	}
+	slices.Sort(urls)
+	return slices.Compact(urls)
+}
+
+func (n *Notifier) batchTransaction(event *wal.Event, subscriptions []*subscription.Subscription) (*notifyMsg, error) {
+	fail := func(reason string) (*notifyMsg, error) {
+		n.batch = nil
+		return nil, errors.New("transaction batch: " + reason)
+	}
+	d := event.Data
+	if d == nil {
+		return fail("native framed data required")
+	}
+	if d.TransactionIndex == nil {
+		return fail("native transaction index required")
+	}
+	urls := destinations(subscriptions)
+	if d.Action == "B" {
+		if *d.TransactionIndex != 0 || d.XID == 0 || d.SourceIdentity == nil || d.NextLSN == "" || event.CommitPosition != "" {
+			return fail("invalid begin")
+		}
+		// A reconnect replays B from the last complete checkpoint. Discard only the
+		// unacknowledged memory buffer; the source still owns every retained row.
+		n.batch = &transactionBuffer{xid: d.XID, source: *d.SourceIdentity, nextLSN: d.NextLSN, urls: urls}
+		n.batch.payload.WriteString(`{"Transaction":[`)
+	} else {
+		if n.batch == nil || d.XID != n.batch.xid || *d.TransactionIndex != n.batch.rows+1 {
+			return fail("nonconsecutive or mismatched transaction")
+		}
+		if !slices.Equal(urls, n.batch.urls) {
+			return fail("all transaction events require identical destinations")
+		}
+		switch d.Action {
+		case "C":
+			if d.TransactionCount == nil || *d.TransactionCount != n.batch.rows || d.NextLSN != n.batch.nextLSN || d.SourceIdentity == nil || *d.SourceIdentity != n.batch.source || event.CommitPosition != wal.CommitPosition(d.NextLSN) {
+				return fail("incomplete or mismatched commit")
+			}
+		case "I", "U", "D", "M", "T":
+			if event.CommitPosition != "" {
+				return fail("partial event has checkpoint")
+			}
+			n.batch.rows++
+			if n.batch.rows > n.transactionBatch.MaxRows {
+				return fail("row bound exceeded; recovery required")
+			}
+		default:
+			return fail("unsupported native action")
+		}
+		n.batch.payload.WriteByte(',')
+	}
+	raw, err := n.serialiser(d)
+	if err != nil {
+		n.batch = nil
+		return nil, fmt.Errorf("transaction batch serialise: %w", err)
+	}
+	// Include the final array/object delimiters in every bound measurement.
+	if int64(n.batch.payload.Len()+len(raw)+2) > n.transactionBatch.MaxBytes {
+		return fail("byte bound exceeded; recovery required")
+	}
+	n.batch.payload.Write(raw)
+	if d.Action != "C" {
+		return nil, nil
+	}
+	b := n.batch
+	n.batch = nil
+	if b.rows == 0 {
+		// Receiver writes would generate further empty filtered transactions. This
+		// complete empty cohort is safe to checkpoint without invoking any webhook.
+		return &notifyMsg{commitPosition: event.CommitPosition}, nil
+	}
+	if len(b.urls) == 0 {
+		return fail("nonempty transaction has no destination")
+	}
+	b.payload.WriteString("]}")
+	return &notifyMsg{urls: b.urls, payload: b.payload.Bytes(), lsn: d.NextLSN, commitPosition: event.CommitPosition}, nil
+}
