+	}}
+	require.NoError(t, h.ResetConnection(t.Context()))
+	message, err := h.ReceiveMessage(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, &wal.SourceIdentity{SystemID: "replacement", Timeline: 2, Database: "synthetic", Slot: "framing"}, message.SourceIdentity)
+}
