+// SPDX-License-Identifier: Apache-2.0
+package postgres
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/replication"
+	pgreplication "github.com/xataio/pgstream/pkg/wal/replication/postgres"
+	"testing"
+)
+
+func TestTransactionFramingOnlyCompleteCommitAdvances(t *testing.T) {
+	var events []*wal.Event
+	h := newMockReplicationHandler()
+	h.GetLSNParserFn = func() replication.LSNParser { return pgreplication.NewLSNParser() }
+	l := New(h, func(_ context.Context, e *wal.Event) error { events = append(events, e); return nil }, WithTransactionFraming())
+	send := func(data string) {
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{LSN: 999, Data: []byte(data)}))
+	}
+	send(`{"action":"B","xid":7,"nextlsn":"0/100"}`)
+	send(`{"action":"I","xid":7,"lsn":"0/50","schema":"public","table":"items"}`)
+	require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{LSN: 99999, ReplyRequested: true}))
+	send(`{"action":"I","xid":7,"lsn":"0/50","schema":"public","table":"items"}`)
+	send(`{"action":"U","xid":7,"lsn":"0/60","schema":"pgstream","table":"internal"}`)
+	send(`{"action":"C","xid":7,"lsn":"0/90","nextlsn":"0/100"}`)
+	require.Len(t, events, 4, "internal rows and keepalive must not alter exposed transaction coverage")
+	for i, e := range events {
+		require.Equal(t, uint64(i), *e.Data.TransactionIndex)
+		if i < 3 {
+			require.Empty(t, e.CommitPosition, "no partial-cohort checkpoint")
+		}
+	}
+	require.Equal(t, uint64(2), *events[3].Data.TransactionCount)
+	require.Equal(t, wal.CommitPosition("0/100"), events[3].CommitPosition)
+}
+
+func TestTransactionFramingReconnectReplaysFromBegin(t *testing.T) {
+	var indices []uint64
+	l := New(newMockReplicationHandler(), func(_ context.Context, e *wal.Event) error {
+		indices = append(indices, *e.Data.TransactionIndex)
+		return nil
+	}, WithTransactionFraming())
+	for _, data := range []string{`{"action":"B","xid":7}`, `{"action":"I","xid":7}`, `{"action":"B","xid":7}`, `{"action":"I","xid":7}`, `{"action":"C","xid":7,"nextlsn":"0/100"}`} {
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+	require.Equal(t, []uint64{0, 1, 0, 1, 2}, indices)
+}
+
+func TestTransactionFramingRefusesUnboundedBoundary(t *testing.T) {
+	for _, data := range []string{`{"action":"I","xid":7}`, `{"action":"C","xid":7,"nextlsn":"0/100"}`, `{"action":"B"}`} {
+		l := New(newMockReplicationHandler(), func(context.Context, *wal.Event) error { t.Fatal("invalid framing reached consumer"); return nil }, WithTransactionFraming())
+		require.Error(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+	for _, data := range []string{`{"action":"I","xid":8}`, `{"action":"C","xid":7}`, `{"action":"C","xid":8,"nextlsn":"0/100"}`} {
+		l := New(newMockReplicationHandler(), func(context.Context, *wal.Event) error { return nil }, WithTransactionFraming())
+		require.NoError(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(`{"action":"B","xid":7}`)}))
+		require.Error(t, l.processWALEvent(t.Context(), &replication.Message{Data: []byte(data)}))
+	}
+}
