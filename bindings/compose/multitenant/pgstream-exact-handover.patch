diff --git a/pkg/wal/processor/webhook/notifier/transaction_slice_test.go b/pkg/wal/processor/webhook/notifier/transaction_slice_test.go
new file mode 100644
index 0000000..4929f8a
--- /dev/null
+++ b/pkg/wal/processor/webhook/notifier/transaction_slice_test.go
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/backoff"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+)
+
+var sliceTenants = []string{"11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222", "33333333-3333-4333-8333-333333333333", "01234567-89ab-cdef-0123-456789abcdef"}
+
+func TestTransactionSliceHashConformance(t *testing.T) {
+	// These vectors use the exact unsigned 64-bit big-endian prefix, independently
+	// calculated from the application's sha256-modulo-v1 rule. K3/K7 catch a
+	// truncated 32-bit prefix that power-of-two configurations can conceal.
+	for i, expected := range [][2]int{{1, 0}, {0, 0}, {1, 3}, {0, 6}} {
+		require.Equal(t, expected[0], tenantBucket(sliceTenants[i], 3), "K3 exact 64-bit prefix")
+		require.Equal(t, expected[1], tenantBucket(sliceTenants[i], 7), "K7 exact 64-bit prefix")
+	}
+}
+func sliceFixture(k int) (*Notifier, []*subscription.Subscription, func(string, uint64) *wal.Event) {
+	n, _, event := batchFixture()
+	n.transactionBatch.MaxRows = 10
+	n.transactionBatch.MaxBytes = 16384
+	urls := make([]string, k)
+	subs := make([]*subscription.Subscription, k)
+	for i := range urls {
+		urls[i] = fmt.Sprintf("http://worker-%d:19913/pgstream", k-i)
+		subs[i] = &subscription.Subscription{URL: urls[i]}
+	}
+	n.transactionBatch.SliceReceivers = urls
+	return n, subs, event
+}
+func tenantEvent(event func(string, uint64) *wal.Event, action string, index uint64, tenant string) *wal.Event {
+	e := event(action, index)
+	e.Data.Schema = "clinical"
+	e.Data.Table = "entries"
+	e.Data.Columns = []wal.Column{{Name: "tenant_id", Type: "uuid", Value: tenant}, {Name: "doc", Type: "jsonb", Value: map[string]any{"synthetic": true}}}
+	if action == "D" {
+		e.Data.Identity = e.Data.Columns
+		e.Data.Columns = nil
+	}
+	return e
+}
+func completeSlice(t *testing.T, n *Notifier, subs []*subscription.Subscription, events []*wal.Event) *notifyMsg {
+	t.Helper()
+	var msg *notifyMsg
+	for index, e := range events {
+		var err error
+		msg, err = n.batchTransaction(e, subs)
+		require.NoError(t, err)
+		if index < len(events)-1 {
+			require.Nil(t, msg, "partial cohort never enters sender")
+		}
+	}
+	require.NotNil(t, msg)
+	return msg
+}
+
+type sliceEnvelope struct {
+	Slice struct {
+		Count   int `json:"count"`
+		Ordinal int `json:"ordinal"`
+	}
+	Transaction []json.RawMessage
+}
+
+func TestTransactionSliceWholeCohortAndMarkers(t *testing.T) {
+	n, subs, event := sliceFixture(3)
+	marker := event("M", 2)
+	marker.Data.Prefix = "pgstream.ddl"
+	marker.Data.Content = `{"schema_name":"clinical","objects":[]}`
+	original := []*wal.Event{event("B", 0), tenantEvent(event, "I", 1, sliceTenants[0]), marker, tenantEvent(event, "D", 3, sliceTenants[1]), tenantEvent(event, "U", 4, sliceTenants[0]), event("C", 5)}
+	msg := completeSlice(t, n, subs, original)
+	require.Equal(t, n.transactionBatch.SliceReceivers, msg.urls, "ordinal order does not sort URLs")
+	require.Empty(t, msg.payload)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+	for ordinal, address := range msg.urls {
+		var envelope sliceEnvelope
+		require.NoError(t, json.Unmarshal(msg.payloads[address], &envelope))
+		require.Equal(t, 3, envelope.Slice.Count)
+		require.Equal(t, ordinal, envelope.Slice.Ordinal)
+		var want []uint64
+		switch ordinal {
+		case 0:
+			want = []uint64{0, 2, 3, 5}
+		case 1:
+			want = []uint64{0, 1, 2, 4, 5}
+		case 2:
+			want = []uint64{0, 2, 5}
+		}
+		var got []uint64
+		for _, raw := range envelope.Transaction {
+			var d wal.Data
+			require.NoError(t, json.Unmarshal(raw, &d))
+			got = append(got, *d.TransactionIndex)
+			if d.Action == "C" {
+				require.Equal(t, uint64(4), *d.TransactionCount, "original source count is retained despite projection gaps")
+				require.Equal(t, original[0].Data.SourceIdentity, d.SourceIdentity)
+			}
+		}
+		require.Equal(t, want, got)
+		begin, _ := n.serialiser(original[0].Data)
+		commit, _ := n.serialiser(original[len(original)-1].Data)
+		require.JSONEq(t, string(begin), string(envelope.Transaction[0]))
+		require.JSONEq(t, string(commit), string(envelope.Transaction[len(envelope.Transaction)-1]))
+	}
+	require.Equal(t, len(msg.payloads[msg.urls[0]])+len(msg.payloads[msg.urls[1]])+len(msg.payloads[msg.urls[2]])+len(msg.urls[0])+len(msg.urls[1])+len(msg.urls[2]), msg.size())
+}
+func TestTransactionSliceK1ParityAndSilentSlices(t *testing.T) {
+	for _, k := range []int{1, 3, 7} {
+		t.Run(fmt.Sprint(k), func(t *testing.T) {
+			n, subs, event := sliceFixture(k)
+			original := []*wal.Event{event("B", 0), tenantEvent(event, "I", 1, sliceTenants[0]), event("C", 2)}
+			msg := completeSlice(t, n, subs, original)
+			ordinal := tenantBucket(sliceTenants[0], k)
+			require.Equal(t, []string{n.transactionBatch.SliceReceivers[ordinal]}, msg.urls, "idle slices receive no B/C-only feedback")
+			var envelope sliceEnvelope
+			require.NoError(t, json.Unmarshal(msg.payloads[msg.urls[0]], &envelope))
+			require.Equal(t, ordinal, envelope.Slice.Ordinal)
+			require.Len(t, envelope.Transaction, len(original))
+			for i, e := range original {
+				raw, err := n.serialiser(e.Data)
+				require.NoError(t, err)
+				require.JSONEq(t, string(raw), string(envelope.Transaction[i]))
+			}
