+
+// TransactionBatchConfig bounds one complete native transaction envelope. A
+// refused transaction retains its source WAL checkpoint for explicit recovery.
+type TransactionBatchConfig struct {
+	MaxRows        uint64   `mapstructure:"max_rows" yaml:"max_rows"`
+	MaxBytes       int64    `mapstructure:"max_bytes" yaml:"max_bytes"`
+	SliceReceivers []string `mapstructure:"slice_receivers" yaml:"slice_receivers"`
+}
+
+// Validate checks the opt-in ordered instance roster before starting a source.
+// Absence preserves the established unsliced transaction envelope.
+func (c *TransactionBatchConfig) Validate() error {
+	if c.MaxRows == 0 || c.MaxBytes <= 0 {
+		return errors.New("transaction batch requires positive row/byte bounds")
+	}
+	if c.SliceReceivers == nil {
+		return nil
+	}
+	if len(c.SliceReceivers) < 1 || len(c.SliceReceivers) > 1024 {
+		return errors.New("slice receivers require 1 to 1024 ordered instances")
+	}
+	seen := make(map[string]bool, len(c.SliceReceivers))
+	for _, address := range c.SliceReceivers {
+		u, err := url.Parse(address)
+		if err != nil || u.Scheme != "http" || u.Hostname() == "" || u.User != nil || u.Path != "/pgstream" || u.RawPath != "" || u.RawQuery != "" || u.ForceQuery || strings.ToLower(u.Host) != u.Host || u.Fragment != "" || u.String() != address {
+			return errors.New("slice receiver must be an explicit http instance /pgstream URL")
+		}
+		port, err := strconv.Atoi(u.Port())
+		if err != nil || port < 1024 || port > 65535 || strconv.Itoa(port) != u.Port() || seen[address] {
+			return errors.New("slice receivers require distinct explicit instance ports/addresses")
+		}
+		seen[address] = true
+	}
+	return nil
+}
diff --git a/pkg/wal/processor/webhook/notifier/transaction_batch.go b/pkg/wal/processor/webhook/notifier/transaction_batch.go
new file mode 100644
index 0000000..e2be070
--- /dev/null
+++ b/pkg/wal/processor/webhook/notifier/transaction_batch.go
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+)
+
+// The listener is serial in framed mode. This additional lock keeps this
+// opt-in processor's advertised concurrent-call contract explicit. No partial
+// envelope enters the sender queue, so neither partial HTTP success nor source
+// checkpoint advancement is possible. At most one bounded envelope is retained.
+type transactionBuffer struct {
+	payload   bytes.Buffer
+	xid       int64
+	rows      uint64
+	source    wal.SourceIdentity
+	nextLSN   string
+	urls      []string
+	slices    []string
+	projected []projectedData
+}
+
+func destinations(subscriptions []*subscription.Subscription) []string {
+	urls := make([]string, 0, len(subscriptions))
+	for _, s := range subscriptions {
+		urls = append(urls, s.URL)
+	}
+	slices.Sort(urls)
+	return slices.Compact(urls)
+}
+
+func (n *Notifier) batchTransaction(event *wal.Event, subscriptions []*subscription.Subscription) (*notifyMsg, error) {
+	fail := func(reason string) (*notifyMsg, error) {
+		n.batch = nil
+		return nil, errors.New("transaction batch: " + reason)
+	}
+	d := event.Data
+	if d == nil {
+		return fail("native framed data required")
+	}
+	if d.TransactionIndex == nil {
+		return fail("native transaction index required")
+	}
+	urls := destinations(subscriptions)
+	if d.Action == "B" && n.transactionBatch.SliceReceivers != nil {
+		if err := n.transactionBatch.Validate(); err != nil {
+			return fail(err.Error())
+		}
+		expected := slices.Clone(n.transactionBatch.SliceReceivers)
+		slices.Sort(expected)
+		if !slices.Equal(urls, expected) {
+			return fail("subscriptions do not cover exact slice receiver roster")
+		}
+	}
+	if d.Action == "B" {
+		if *d.TransactionIndex != 0 || d.XID == 0 || d.SourceIdentity == nil || d.NextLSN == "" || event.CommitPosition != "" {
+			return fail("invalid begin")
+		}
+		// A reconnect replays B from the last complete checkpoint. Discard only the
+		// unacknowledged memory buffer; the source still owns every retained row.
+		n.batch = &transactionBuffer{xid: d.XID, source: *d.SourceIdentity, nextLSN: d.NextLSN, urls: urls, slices: slices.Clone(n.transactionBatch.SliceReceivers)}
+		n.batch.payload.WriteString(`{"Transaction":[`)
+	} else {
+		if n.batch == nil || d.XID != n.batch.xid || *d.TransactionIndex != n.batch.rows+1 {
+			return fail("nonconsecutive or mismatched transaction")
+		}
+		if !slices.Equal(urls, n.batch.urls) {
+			return fail("all transaction events require identical destinations")
+		}
+		switch d.Action {
+		case "C":
+			if d.TransactionCount == nil || *d.TransactionCount != n.batch.rows || d.NextLSN != n.batch.nextLSN || d.SourceIdentity == nil || *d.SourceIdentity != n.batch.source || event.CommitPosition != wal.CommitPosition(d.NextLSN) {
+				return fail("incomplete or mismatched commit")
+			}
+		case "I", "U", "D", "M", "T":
+			if d.Action == "T" && n.batch.slices != nil {
+				return fail("truncate has no tenant slice")
+			}
+			if event.CommitPosition != "" {
+				return fail("partial event has checkpoint")
+			}
+			n.batch.rows++
+			if n.batch.rows > n.transactionBatch.MaxRows {
+				return fail("row bound exceeded; recovery required")
+			}
+		default:
+			return fail("unsupported native action")
+		}
+		n.batch.payload.WriteByte(',')
+	}
+	raw, err := n.serialiser(d)
+	if err != nil {
+		n.batch = nil
+		return nil, fmt.Errorf("transaction batch serialise: %w", err)
+	}
+	// Include the final array/object delimiters in every bound measurement.
+	if int64(n.batch.payload.Len()+len(raw)+2) > n.transactionBatch.MaxBytes {
+		return fail("byte bound exceeded; recovery required")
+	}
+	if n.batch.slices != nil {
+		ordinal := -1
+		if d.Action == "I" || d.Action == "U" || d.Action == "D" {
+			tenant, err := tenantID(d)
+			if err != nil {
+				return fail(err.Error())
+			}
+			ordinal = tenantBucket(tenant, len(n.batch.slices))
+		} else if d.Action == "M" && d.Prefix != "pgstream.ddl" {
+			return fail("unsupported sliced control marker")
+		}
+		n.batch.projected = append(n.batch.projected, projectedData{raw: raw, ordinal: ordinal})
+	}
+	n.batch.payload.Write(raw)
+	if d.Action != "C" {
+		return nil, nil
+	}
+	b := n.batch
+	n.batch = nil
+	if b.rows == 0 {
+		// Receiver writes would generate further empty filtered transactions. This
+		// complete empty cohort is safe to checkpoint without invoking any webhook.
+		return &notifyMsg{commitPosition: event.CommitPosition}, nil
+	}
+	if len(b.urls) == 0 {
+		return fail("nonempty transaction has no destination")
+	}
+	if b.slices != nil {
+		return n.projectTransaction(b, d.NextLSN, event.CommitPosition)
+	}
+	b.payload.WriteString("]}")
+	return &notifyMsg{urls: b.urls, payload: b.payload.Bytes(), lsn: d.NextLSN, commitPosition: event.CommitPosition}, nil
+}
+
+// Source indices and C's original count remain unchanged. The receiver admits
+// the gaps only through this explicit slice envelope; this producer validated
+// the original complete cohort before projection.
+type projectedData struct {
+	raw     json.RawMessage
+	ordinal int
+}
+
+var canonicalTenant = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+func tenantID(d *wal.Data) (string, error) {
+	tenant := ""
+	for _, columns := range [][]wal.Column{d.Identity, d.Columns} {
+		found := false
+		for _, column := range columns {
+			if column.Name == "tenant_id" {
+				value, ok := column.Value.(string)
+				if found || !ok || !canonicalTenant.MatchString(value) || value == "00000000-0000-0000-0000-000000000000" || tenant != "" && tenant != value {
+					return "", errors.New("invalid or changing tenant_id")
+				}
+				found = true
+				tenant = value
+			}
+		}
+	}
+	if tenant == "" {
+		return "", errors.New("missing tenant_id")
+	}
+	return tenant, nil
+}
+func tenantBucket(tenant string, count int) int {
+	digest := sha256.Sum256([]byte(tenant))
+	return int(binary.BigEndian.Uint64(digest[:8]) % uint64(count))
+}
+func (n *Notifier) projectTransaction(b *transactionBuffer, lsn string, position wal.CommitPosition) (*notifyMsg, error) {
+	msg := &notifyMsg{payloads: make(map[string][]byte), lsn: lsn, commitPosition: position}
+	total := int64(0)
+	for ordinal, address := range b.slices {
+		changes := false
+		rows := make([]json.RawMessage, 0, len(b.projected))
+		for index, data := range b.projected {
+			if data.ordinal == -1 || data.ordinal == ordinal {
+				rows = append(rows, data.raw)
+				if index > 0 && index < len(b.projected)-1 {
+					changes = true
+				}
+			}
+		}
+		if !changes {
+			continue
+		}
+		prefix := fmt.Sprintf(`{"Slice":{"count":%d,"ordinal":%d},"Transaction":[`, len(b.slices), ordinal)
+		size := int64(len(prefix) + 2 + len(address) + max(0, len(rows)-1))
+		for _, raw := range rows {
+			size += int64(len(raw))
+		}
+		// Refuse before allocating a fanout that exceeds the existing sender budget.
+		// No extra delivery queue or checkpoint is created by slice projection.
+		if size-int64(len(address)) > n.transactionBatch.MaxBytes || total+size > n.queueLimit {
+			return nil, errors.New("transaction slice exceeds byte/queue bound; recovery required")
+		}
+		var out strings.Builder
+		out.Grow(int(size) - len(address))
+		out.WriteString(prefix)
+		for i, raw := range rows {
+			if i != 0 {
+				out.WriteByte(',')
+			}
+			out.Write(raw)
+		}
+		out.WriteString("]}")
+		msg.urls = append(msg.urls, address)
+		msg.payloads[address] = []byte(out.String())
+		total += size
+	}
+	if len(msg.urls) == 0 {
+		return nil, errors.New("nonempty transaction has no selected slice")
+	}
+	return msg, nil
+}
diff --git a/pkg/wal/processor/webhook/notifier/transaction_batch_test.go b/pkg/wal/processor/webhook/notifier/transaction_batch_test.go
new file mode 100644
index 0000000..5875d4e
--- /dev/null
+++ b/pkg/wal/processor/webhook/notifier/transaction_batch_test.go
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+)
+
+func batchFixture() (*Notifier, []*subscription.Subscription, func(string, uint64) *wal.Event) {
+	n := New(&Config{StrictMode: true, TransactionBatch: &TransactionBatchConfig{MaxRows: 2, MaxBytes: 4096}}, nil)
+	subs := []*subscription.Subscription{{URL: "http://receiver/"}}
+	source := &wal.SourceIdentity{SystemID: "native-source", Timeline: 1, Database: "clinical", Slot: "deployment"}
+	event := func(action string, index uint64) *wal.Event {
+		d := &wal.Data{Action: action, XID: 123, LSN: "0/100", TransactionIndex: &index}
+		e := &wal.Event{Data: d}
+		if action == "B" || action == "C" {
+			d.SourceIdentity = source
+			d.NextLSN = "0/200"
+		}
+		if action == "C" {
+			count := index - 1
+			d.TransactionCount = &count
+			e.CommitPosition = "0/200"
+		}
+		return e
+	}
+	return n, subs, event
+}
+func TestTransactionBatchOnlyCompleteEnvelopeCanBeSent(t *testing.T) {
+	n, subs, event := batchFixture()
+	for _, e := range []*wal.Event{event("B", 0), event("I", 1), event("U", 2)} {
+		msg, err := n.batchTransaction(e, subs)
+		require.NoError(t, err)
+		require.Nil(t, msg, "partial input cannot enter HTTP queue")
+	}
+	msg, err := n.batchTransaction(event("C", 3), subs)
+	require.NoError(t, err)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+	var payload struct{ Transaction []*wal.Data }
+	require.NoError(t, json.Unmarshal(msg.payload, &payload))
+	require.Len(t, payload.Transaction, 4)
+	require.Equal(t, []string{"B", "I", "U", "C"}, []string{payload.Transaction[0].Action, payload.Transaction[1].Action, payload.Transaction[2].Action, payload.Transaction[3].Action})
+	require.Equal(t, []string{"http://receiver/"}, msg.urls)
+	require.Nil(t, n.batch)
+}
+func TestTransactionBatchRefusesUnrecoverablePartialAcceptance(t *testing.T) {
+	for _, scenario := range []string{"rows", "bytes", "count", "index", "source", "destinations", "partial-checkpoint"} {
+		t.Run(scenario, func(t *testing.T) {
+			n, subs, event := batchFixture()
+			_, err := n.batchTransaction(event("B", 0), subs)
+			require.NoError(t, err)
+			row := event("I", 1)
+			switch scenario {
+			case "rows":
+				n.transactionBatch.MaxRows = 0
+			case "bytes":
+				n.transactionBatch.MaxBytes = 1
+			case "index":
+				*row.Data.TransactionIndex = 2
+			case "destinations":
+				subs = []*subscription.Subscription{{URL: "http://other/"}}
+			case "partial-checkpoint":
+				row.CommitPosition = "0/200"
+			}
+			msg, err := n.batchTransaction(row, subs)
+			if scenario == "count" || scenario == "source" {
+				require.NoError(t, err)
+				require.Nil(t, msg)
+				c := event("C", 2)
+				if scenario == "count" {
+					*c.Data.TransactionCount = 0
+				} else {
+					changed := *c.Data.SourceIdentity
+					changed.Timeline = 2
+					c.Data.SourceIdentity = &changed
+				}
+				msg, err = n.batchTransaction(c, subs)
+			}
+			require.Error(t, err)
+			require.Nil(t, msg)
+			require.Nil(t, n.batch, "failed partial input must remain solely source-owned")
+		})
+	}
+}
+func TestTransactionBatchEmptyCohortCannotCreateReceiverFeedback(t *testing.T) {
+	n, subs, event := batchFixture()
+	_, err := n.batchTransaction(event("B", 0), subs)
+	require.NoError(t, err)
+	msg, err := n.batchTransaction(event("C", 1), subs)
+	require.NoError(t, err)
+	require.Empty(t, msg.urls)
+	require.Empty(t, msg.payload)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+}
+func TestTransactionBatchReconnectReplaysWholeCohort(t *testing.T) {
+	n, subs, event := batchFixture()
+	for _, e := range []*wal.Event{event("B", 0), event("I", 1), event("B", 0), event("I", 1)} {
+		m, err := n.batchTransaction(e, subs)
+		require.NoError(t, err)
+		require.Nil(t, m)
+	}
+	msg, err := n.batchTransaction(event("C", 2), subs)
+	require.NoError(t, err)
+	var payload struct{ Transaction []*wal.Data }
+	require.NoError(t, json.Unmarshal(msg.payload, &payload))
+	require.Len(t, payload.Transaction, 3)
+}
