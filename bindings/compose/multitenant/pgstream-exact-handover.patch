+func TestTransactionFramingReconnectRefreshesSourceIdentity(t *testing.T) {
+	replacement := &pgmocks.ReplicationConn{
+		IdentifySystemFn: func(context.Context) (pglib.IdentifySystemResult, error) {
+			return pglib.IdentifySystemResult{SystemID: "replacement", Timeline: 2, DBName: "synthetic"}, nil
+		},
+		StartReplicationFn:        func(context.Context, pglib.ReplicationConfig) error { return nil },
+		SendStandbyStatusUpdateFn: func(context.Context, uint64) error { return nil },
+		ReceiveMessageFn: func(context.Context) (*pglib.ReplicationMessage, error) {
+			return &pglib.ReplicationMessage{WALData: []byte(`{"action":"B","xid":7}`)}, nil
+		},
+	}
+	h := &Handler{logger: loglib.NewNoopLogger(), logFields: loglib.Fields{}, lsnParser: NewLSNParser(), transactionFraming: true, pgReplicationSlotName: "framing", sourceIdentity: &wal.SourceIdentity{SystemID: "original", Timeline: 1, Database: "synthetic", Slot: "framing"}, pgReplicationConn: &pgmocks.ReplicationConn{CloseFn: func(context.Context) error { return nil }}, pgReplicationConnBuilder: func() (pglib.ReplicationQuerier, error) { return replacement, nil }, pgConnBuilder: func() (pglib.Querier, error) {
+		return &pgmocks.Querier{QueryRowFn: func(_ context.Context, dest []any, _ string, _ ...any) error {
+			*dest[0].(*string) = "0/100"
+			return nil
+		}, CloseFn: func(context.Context) error { return nil }}, nil
+	}}
+	require.NoError(t, h.ResetConnection(t.Context()))
+	message, err := h.ReceiveMessage(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, &wal.SourceIdentity{SystemID: "replacement", Timeline: 2, Database: "synthetic", Slot: "framing"}, message.SourceIdentity)
+}
