diff --git a/cmd/config/startup_transport.go b/cmd/config/startup_transport.go
new file mode 100644
index 0000000..24bdce3
--- /dev/null
+++ b/cmd/config/startup_transport.go
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: Apache-2.0
+package config
+
+import (
+	"errors"
+	"reflect"
+)
+
+// Validate before mapstructure/yaml can coerce fractional or string scalars into
+// integers. This strict input rule is scoped to the new optional document.
+func validateStartupTransportInput(value any) error {
+	if value == nil {
+		return nil
+	}
+	fields, ok := value.(map[string]any)
+	if !ok || len(fields) != 3 {
+		return errors.New("startup transport requires receivers and exact integer timing fields")
+	}
+	for _, key := range []string{"timeout_ms", "retry_interval_ms"} {
+		v, exists := fields[key]
+		if !exists || v == nil {
+			return errors.New("startup transport timing must be an integer scalar")
+		}
+		switch reflect.TypeOf(v).Kind() {
+		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64, reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		default:
+			return errors.New("startup transport timing must be an integer scalar")
+		}
+	}
+	if _, exists := fields["receivers"]; !exists {
+		return errors.New("startup transport requires explicit receivers")
+	}
+	values := reflect.ValueOf(fields["receivers"])
+	if !values.IsValid() || values.Kind() != reflect.Slice {
+		return errors.New("startup transport receivers must be an explicit string list")
+	}
+	for i := 0; i < values.Len(); i++ {
+		if _, ok := values.Index(i).Interface().(string); !ok {
+			return errors.New("startup transport receivers must be an explicit string list")
+		}
+	}
+	return nil
+}
diff --git a/cmd/config/startup_transport_test.go b/cmd/config/startup_transport_test.go
new file mode 100644
index 0000000..d572614
--- /dev/null
+++ b/cmd/config/startup_transport_test.go
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/stream"
+)
+
+func TestYAMLStartupTransportNamespaceAndMilliseconds(t *testing.T) {
+	v := viper.New()
+	v.SetConfigType("yaml")
+	require.NoError(t, v.ReadConfig(strings.NewReader(`target:
+  webhooks:
+    startup_transport:
+      receivers: [http://worker:19913/pgstream]
+      timeout_ms: 7200000
+      retry_interval_ms: 25
+    notifier:
+      strict_mode: true
+      worker_count: 1
+      client_timeout: 300000
+      backoff:
+        constant:
+          max_retries: 1
+          interval: 50
+`)))
+	var yaml YAMLConfig
+	require.NoError(t, v.Unmarshal(&yaml))
+	selected := yaml.parseWebhookProcessorConfig()
+	require.Equal(t, &stream.WebhookStartupTransportConfig{Receivers: []string{"http://worker:19913/pgstream"}, TimeoutMS: 7200000, RetryIntervalMS: 25}, selected.StartupTransport)
+	require.True(t, selected.Notifier.StrictMode)
+	require.EqualValues(t, 300000, selected.Notifier.ClientTimeout.Milliseconds())
+	require.EqualValues(t, 1, selected.Notifier.Backoff.Constant.MaxRetries)
+	require.EqualValues(t, 50, selected.Notifier.Backoff.Constant.Interval.Milliseconds())
+	yaml.Target.Webhooks.StartupTransport = nil
+	require.Nil(t, yaml.parseWebhookProcessorConfig().StartupTransport)
+}
+
+func TestYAMLStartupTransportStrictScalarsBeforeCoercion(t *testing.T) {
+	for _, scalar := range []string{"100.5", "100.0", "\"100\"", "true", ".nan"} {
+		t.Run(scalar, func(t *testing.T) {
+			viper.Reset()
+			defer viper.Reset()
+			file := filepath.Join(t.TempDir(), "startup.yaml")
+			require.NoError(t, os.WriteFile(file, []byte("target:\n  webhooks:\n    startup_transport:\n      receivers: [http://worker:19913/pgstream]\n      timeout_ms: "+scalar+"\n      retry_interval_ms: 1\n"), 0600))
+			require.NoError(t, LoadFile(file))
+			_, err := ParseStreamConfig()
+			require.ErrorContains(t, err, "integer scalar", "invalid raw timing must refuse before target/source parsing")
+		})
+	}
+}
