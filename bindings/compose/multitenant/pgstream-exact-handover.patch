+	}
+	n, subs, event := sliceFixture(3)
+	msg := completeSlice(t, n, subs, []*wal.Event{event("B", 0), event("C", 1)})
+	require.Empty(t, msg.urls)
+	require.Empty(t, msg.payloads)
+	require.Equal(t, wal.CommitPosition("0/200"), msg.commitPosition)
+}
+func TestTransactionSliceRefusals(t *testing.T) {
+	scenarios := []string{"missing-tenant", "uppercase-tenant", "changing-tenant", "duplicate-column", "invalid-tenant", "truncate", "unknown-marker", "roster", "rows", "bytes", "count", "index", "source", "partial-checkpoint"}
+	for _, scenario := range scenarios {
+		t.Run(scenario, func(t *testing.T) {
+			n, subs, event := sliceFixture(3)
+			_, err := n.batchTransaction(event("B", 0), subs)
+			require.NoError(t, err)
+			row := tenantEvent(event, "I", 1, sliceTenants[0])
+			switch scenario {
+			case "missing-tenant":
+				row.Data.Columns = nil
+			case "uppercase-tenant":
+				row.Data.Columns[0].Value = "ABCDEF01-1111-4111-8111-111111111111"
+			case "changing-tenant":
+				row.Data.Identity = []wal.Column{{Name: "tenant_id", Value: sliceTenants[1]}}
+			case "duplicate-column":
+				row.Data.Columns = append(row.Data.Columns, row.Data.Columns[0])
+			case "invalid-tenant":
+				row.Data.Columns[0].Value = 123
+			case "truncate":
+				row.Data.Action = "T"
+			case "unknown-marker":
+				row.Data.Action = "M"
+				row.Data.Prefix = "arbitrary"
+			case "roster":
+				subs = subs[:2]
+			case "rows":
+				n.transactionBatch.MaxRows = 0
+			case "bytes":
+				n.transactionBatch.MaxBytes = 1
+			case "index":
+				*row.Data.TransactionIndex = 2
+			case "partial-checkpoint":
+				row.CommitPosition = "0/200"
+			}
+			msg, err := n.batchTransaction(row, subs)
+			if scenario == "count" || scenario == "source" {
+				require.NoError(t, err)
+				require.Nil(t, msg)
+				commit := event("C", 2)
+				if scenario == "count" {
+					*commit.Data.TransactionCount = 0
+				} else {
+					changed := *commit.Data.SourceIdentity
+					changed.Slot = "other"
+					commit.Data.SourceIdentity = &changed
+				}
+				msg, err = n.batchTransaction(commit, subs)
+			}
+			require.Error(t, err)
+			require.Nil(t, msg)
+			require.Nil(t, n.batch)
+		})
+	}
+}
+func TestTransactionSliceEnvelopeAndQueueBounds(t *testing.T) {
+	n, subs, event := sliceFixture(3)
+	original := []*wal.Event{event("B", 0), tenantEvent(event, "I", 1, sliceTenants[0]), event("C", 2)}
+	msg := completeSlice(t, n, subs, original)
+	originalBytes, _ := json.Marshal(map[string]any{"Transaction": []*wal.Data{original[0].Data, original[1].Data, original[2].Data}})
+	require.Greater(t, len(msg.payloads[msg.urls[0]]), len(originalBytes))
+	n.transactionBatch.MaxBytes = int64(len(originalBytes))
+	_, err := n.batchTransaction(original[0], subs)
+	require.NoError(t, err)
+	_, err = n.batchTransaction(original[1], subs)
+	require.NoError(t, err)
+	failed, err := n.batchTransaction(original[2], subs)
+	require.ErrorContains(t, err, "slice exceeds byte/queue bound")
+	require.Nil(t, failed)
+	n.transactionBatch.MaxBytes = 16384
+	n.queueLimit = 1000
+	marker := event("M", 1)
+	marker.Data.Prefix = "pgstream.ddl"
+	marker.Data.Content = `{"schema_name":"clinical","objects":[]}`
+	_, err = n.batchTransaction(event("B", 0), subs)
+	require.NoError(t, err)
+	_, err = n.batchTransaction(marker, subs)
+	require.NoError(t, err)
+	failed, err = n.batchTransaction(event("C", 2), subs)
+	require.ErrorContains(t, err, "slice exceeds byte/queue bound")
+	require.Nil(t, failed)
+}
+func TestTransactionSliceStrictAcceptanceAndReplay(t *testing.T) {
+	for _, failure := range []string{"refusal", "lost-reply"} {
+		t.Run(failure, func(t *testing.T) {
+			var unavailable atomic.Bool
+			unavailable.Store(true)
+			var mu sync.Mutex
+			bodies := map[int][][]byte{}
+			var positions []wal.CommitPosition
+			server := func(ordinal int) *httptest.Server {
+				return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					raw, err := io.ReadAll(r.Body)
+					require.NoError(t, err)
+					mu.Lock()
+					bodies[ordinal] = append(bodies[ordinal], raw)
+					mu.Unlock()
+					require.Equal(t, "0/200", r.Header.Get("X-Pgstream-LSN"))
+					require.Equal(t, "0/200", r.Header.Get("Idempotency-Key"))
+					if ordinal == 1 && unavailable.Load() {
+						if failure == "lost-reply" {
+							conn, _, err := w.(http.Hijacker).Hijack()
+							require.NoError(t, err)
+							require.NoError(t, conn.Close())
+							return
+						}
+						w.WriteHeader(http.StatusServiceUnavailable)
+						return
+					}
+					w.WriteHeader(http.StatusNoContent)
+				}))
+			}
+			a, b := server(0), server(1)
+			defer a.Close()
+			defer b.Close()
+			n, _, event := sliceFixture(2)
+			n.transactionBatch.SliceReceivers = []string{a.URL + "/pgstream", b.URL + "/pgstream"}
+			n.backoffProvider = backoff.NewProvider(&backoff.Config{DisableRetries: true})
+			n.checkpointer = func(_ context.Context, values []wal.CommitPosition) error {
+				positions = append(positions, values...)
+				return nil
+			}
+			subs := []*subscription.Subscription{{URL: n.transactionBatch.SliceReceivers[1]}, {URL: n.transactionBatch.SliceReceivers[0]}}
+			marker := event("M", 1)
+			marker.Data.Prefix = "pgstream.ddl"
+			marker.Data.Content = `{"schema_name":"clinical","objects":[]}`
+			original := []*wal.Event{event("B", 0), marker, event("C", 2)}
+			msg := completeSlice(t, n, subs, original)
+			require.Error(t, n.notify(t.Context(), msg))
+			require.Empty(t, positions, "one failed receiver retains the shared source checkpoint")
+			mu.Lock()
+			require.Len(t, bodies[0], 1)
+			require.Len(t, bodies[1], 1)
+			mu.Unlock()
+			unavailable.Store(false)
+			// Reconnect can discard an unaccepted partial buffer, then replay the exact
+			// complete source position. Every emitted per-URL body is byte-identical.
+			_, err := n.batchTransaction(event("B", 0), subs)
+			require.NoError(t, err)
+			replay := completeSlice(t, n, subs, original)
+			require.Equal(t, msg.payloads, replay.payloads)
+			require.NoError(t, n.notify(t.Context(), replay))
+			require.Equal(t, []wal.CommitPosition{"0/200"}, positions)
+			mu.Lock()
+			defer mu.Unlock()
+			for _, seen := range bodies {
+				require.Len(t, seen, 2)
+				require.Equal(t, seen[0], seen[1])
+			}
+			require.True(t, slices.Equal(msg.urls, replay.urls))
+		})
+	}
+}
