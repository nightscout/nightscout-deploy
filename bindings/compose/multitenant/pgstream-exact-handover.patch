+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"github.com/xataio/pgstream/pkg/wal"
+	"testing"
+)
+
+func TestTransactionFramingUncommittedMessagesDoNotCheckpoint(t *testing.T) {
+	var saved []wal.CommitPosition
+	n := New(&Config{}, nil, WithCheckpoint(func(_ context.Context, p []wal.CommitPosition) error { saved = append(saved, p...); return nil }))
+	require.NoError(t, n.notify(t.Context(), &notifyMsg{}))
+	require.Empty(t, saved, "durable row acceptance must not checkpoint incomplete transaction")
